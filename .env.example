# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (native PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=siapajar
DB_PASSWORD=
DB_DATABASE=siapajar

# Redis (native Redis via @adonisjs/redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_DRIVER=redis
AI_QUEUE_MAX_CONCURRENCY=10
AI_QUEUE_MAX_ATTEMPTS=3

# AI Router (9router.com)
APP_URL=http://localhost:3333
ROUTER_API_KEY=
# Produksi: https://9router.com/v1/chat/completions — lokal: http://localhost:20128/v1/chat/completions
ROUTER_API_URL=http://localhost:20128/v1/chat/completions
# Provider-specific aggregator keys. The active gateway is selected in admin AI settings.
COMMAND_CODE_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_ZEN_API_KEY=
TOGETHER_API_KEY=
# Legacy shared fallback for existing deployments. Admin database key takes precedence.
AGGREGATOR_API_KEY=
CODEX_CLI_PATH=codex
PDF_BROWSER_EXECUTABLE_PATH=

# Payment (Xendit)
XENDIT_KEY=

# WhatsApp (Baileys)
WA_SESSION_DIR=./wa-session

# Export Storage
STORAGE_PATH=./storage/exports

# Kurikulum / onboarding
DEFAULT_CURRICULUM_VERSION=Kurikulum Merdeka

# Google OAuth (buat kredensial di Google Cloud Console — OAuth consent screen + client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://${HOST}:${PORT}/auth/google/callback
GEMINI_OAUTH_CALLBACK_URL=http://localhost:3333/admin/ai-settings/oauth/gemini/callback
GEMINI_OAUTH_PROJECT_ID=

# MCP Server (stdio)
# Generate a strong random string and set it here before starting the MCP server.
# Every tool call must pass this value as the api_key argument.
# Leave blank to disable: the server will reject all calls with a configuration error.
SIAPAJAR_MCP_API_KEY=
